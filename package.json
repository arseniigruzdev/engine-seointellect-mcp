{
  "name": "seointellect-mcp",
  "version": "0.1.0",
  "description": "MCP server for all 22 SEO Intellect API tools",
  "homepage": "https://github.com/arseniigruzdev/seointellect-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arseniigruzdev/seointellect-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/arseniigruzdev/seointellect-mcp/issues"
  },
  "type": "module",
  "license": "MIT",
  "bin": {
    "seointellect-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "seo",
    "seointellect"
  ],
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/express": "5.0.3",
    "@types/node": "24.9.1",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vitest": "3.2.7"
  }
}
