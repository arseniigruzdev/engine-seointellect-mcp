# Required in stdio/private HTTP mode. Never commit the real value.
SEOINTELLECT_API_TOKEN=

# HTTP transport settings.
MCP_TRANSPORT=stdio
HOST=127.0.0.1
PORT=3000

# Comma-separated hostnames for a public HTTP deployment.
# Example: mcp.example.com
MCP_ALLOWED_HOSTS=localhost,127.0.0.1

# "byok" reads each caller's Engine SEO Intellect token from Authorization: Bearer.
# "static" uses SEOINTELLECT_API_TOKEN and should be protected by a private network.
MCP_HTTP_AUTH_MODE=byok

# Polling defaults for asynchronous Engine SEO Intellect tasks.
SEOINTELLECT_POLL_INTERVAL_MS=15000
SEOINTELLECT_RESULT_TIMEOUT_MS=120000
